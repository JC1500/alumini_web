generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AlumniProfile {
  id             String   @id @default(cuid())
  clerkUserId    String   @unique
  fullName       String
  username       String   @unique
  headline       String
  bio            String  @db.Text
  profileImageUrl String?
  profileImageKey String?
  coverImageUrl   String?
  coverImageKey   String?
  department     String
  graduationYear Int
  degree         String?
  company        String?
  jobTitle       String?
  location       String
  country        String   @default("India")

  // Temporarily optional for migration
  state          String
  district       String
  city           String

  posts Post[]

  skills         String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fullName])
  @@index([graduationYear])
  @@index([department])
  @@index([company])
}


model Post {
  id        String   @id @default(cuid())
  authorId  String
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author AlumniProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images PostImage[]

  @@index([authorId, createdAt])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  imageUrl  String
  imageKey  String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}


model PendingPostImage {
  id          String   @id @default(cuid())
  clerkUserId String
  imageUrl    String
  imageKey    String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([clerkUserId, expiresAt])
}
