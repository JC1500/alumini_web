generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AlumniProfile {
  id             String   @id @default(cuid())
  clerkUserId    String   @unique
  fullName       String
  username       String   @unique
  headline       String
  bio            String  @db.Text
  profileImageUrl String?
  profileImageKey String?
  coverImageUrl   String?
  coverImageKey   String?
  department     String
  graduationYear Int
  degree         String?
  company        String?
  jobTitle       String?
  location       String
  country        String   @default("India")

  // Temporarily optional for migration
  state          String
  district       String
  city           String

  posts Post[]
  conversationsAsParticipantA Conversation[] @relation("ConversationParticipantA")
  conversationsAsParticipantB Conversation[] @relation("ConversationParticipantB")
  conversationParticipants ConversationParticipant[]
  sentMessages Message[]
  favourites Favourite[]

  skills         String[] @default([])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fullName])
  @@index([graduationYear])
  @@index([department])
  @@index([company])
}


model Post {
  id        String   @id @default(cuid())
  authorId  String
  text      String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author AlumniProfile @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images PostImage[]
  favourites Favourite[]

  @@index([authorId, createdAt])
}

model PostImage {
  id        String   @id @default(cuid())
  postId    String
  imageUrl  String
  imageKey  String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}


model PendingPostImage {
  id          String   @id @default(cuid())
  clerkUserId String
  imageUrl    String
  imageKey    String   @unique
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  consumedAt  DateTime?

  @@index([clerkUserId, expiresAt])
}

model Conversation {
  id             String   @id @default(cuid())
  participantAId String
  participantBId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastMessageAt  DateTime @default(now())

  participantA AlumniProfile @relation("ConversationParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB AlumniProfile @relation("ConversationParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)
  participants ConversationParticipant[]
  messages     Message[]

  @@unique([participantAId, participantBId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  lastReadAt     DateTime?

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         AlumniProfile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  clientId       String    @db.Uuid
  body           String    @db.VarChar(2000)
  createdAt      DateTime  @default(now())
  deletedAt      DateTime?

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       AlumniProfile @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientId])
  @@index([conversationId, createdAt(sort: Desc)])
}

model Favourite {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user AlumniProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId])
  @@index([postId])
}
